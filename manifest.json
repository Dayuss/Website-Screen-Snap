{
  "manifest_version": 3,
  "name": "Website Screen Snap",
  "version": "0.1.0",
  "description": "Screenshot any website: visible area, selected area, or the full page. Export as PNG or PDF.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["activeTab", "scripting", "storage", "clipboardWrite"],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Website Screen Snap",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "commands": {
    "capture-selected": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Capture a selected area"
    },
    "capture-visible": {
      "suggested_key": { "default": "Alt+Shift+V" },
      "description": "Capture the visible area"
    }
  }
}
